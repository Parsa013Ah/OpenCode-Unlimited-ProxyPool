{
  "name": "opencode-free-proxy",
  "version": "1.6.0",
  "description": "High-performance local proxy for OpenCode free-tier AI models \u2014 OpenAI + Anthropic compatible, with auto-rotating proxy pool",
  "type": "module",
  "main": "server.mjs",
  "scripts": {
    "start": "node server.mjs",
    "dev": "node --watch server.mjs",
    "tray": "node server.mjs --tray",
    "tray:hide": "node server.mjs --tray --hide",
    "config": "node menu.mjs",
    "settings": "node menu.mjs"
  },
  "dependencies": {
    "express": "^4.21.0",
    "https-proxy-agent": "^9.1.0",
    "socks-proxy-agent": "^10.1.0",
    "systray": "^1.0.5"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "keywords": [
    "opencode",
    "proxy",
    "openai",
    "anthropic",
    "free-ai",
    "zen-api"
  ]
}
