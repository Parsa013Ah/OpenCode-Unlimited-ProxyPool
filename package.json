{
  "name": "opencode-free-proxy",
  "version": "1.7.0",
  "description": "Local OpenAI + Anthropic compatible proxy for OpenCode free-tier AI models, with an auto-rotating proxy pool (HTTP / SOCKS / V2Ray)",
  "type": "module",
  "main": "src/server.mjs",
  "bin": {
    "opencode-free-proxy": "src/server.mjs"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "dev": "node --watch src/server.mjs",
    "tray": "node src/server.mjs --tray",
    "tray:hide": "node src/server.mjs --tray --hide",
    "config": "node src/cli/menu.mjs",
    "settings": "node src/cli/menu.mjs",
    "test": "node --test"
  },
  "dependencies": {
    "express": "^4.21.0",
    "https-proxy-agent": "^9.1.0",
    "socks-proxy-agent": "^10.1.0",
    "systray": "^1.0.5"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "keywords": [
    "opencode",
    "proxy",
    "openai",
    "anthropic",
    "free-ai",
    "zen-api",
    "v2ray",
    "xray",
    "vmess",
    "vless"
  ]
}
